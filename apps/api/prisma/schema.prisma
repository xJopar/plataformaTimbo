generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum ApplicationStatus {
  ACTIVE
  INACTIVE

  @@map("application_status")
}

enum AccessProfileScope {
  SYSTEM
  APPLICATION

  @@map("access_profile_scope")
}

enum AccessProfileStatus {
  ACTIVE
  INACTIVE

  @@map("access_profile_status")
}

enum ApplicationPermissionStatus {
  ACTIVE
  INACTIVE

  @@map("application_permission_status")
}

enum AuditActorType {
  USER
  SYSTEM
  ANONYMOUS

  @@map("audit_actor_type")
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE

  @@map("audit_outcome")
}

enum FiveSIndicatorStatus {
  ACTIVE
  INACTIVE

  @@map("five_s_indicator_status")
}

enum FiveSEntryValue {
  MET
  NOT_MET
  NOT_APPLICABLE

  @@map("five_s_entry_value")
}


model User {
  id             String        @id @default(uuid()) @db.Uuid
  displayName    String?       @map("display_name")
  corporateEmail String        @unique @map("corporate_email")
  googleSubject  String?       @unique @map("google_subject")
  zohoCrmUserId  String?       @unique @map("zoho_crm_user_id")
  status         UserStatus    @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deactivatedAt  DateTime?     @map("deactivated_at") @db.Timestamptz(6)
  sessions       UserSession[]
  profileAssignments UserProfileAssignment[]
  applicationAssignments UserApplicationAssignment[]
  auditEvents    AuditEvent[]  @relation("AuditEventActorUser")
  usageEvents    UsageEvent[]  @relation("UsageEventActorUser")
  fiveSEntries         FiveSDailyEntry[] @relation("FiveSDailyEntryUser")
  fiveSEntriesRecorded FiveSDailyEntry[] @relation("FiveSDailyEntryRecordedBy")

  @@map("users")
}

model AccessProfile {
  id          String                  @id @default(uuid()) @db.Uuid
  key         String
  name        String
  description String?
  scope       AccessProfileScope
  applicationId String?               @map("application_id") @db.Uuid
  status      AccessProfileStatus     @default(ACTIVE)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deactivatedAt DateTime?             @map("deactivated_at") @db.Timestamptz(6)
  application Application?            @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  assignments UserProfileAssignment[]
  permissions AccessProfilePermission[]

  @@unique([applicationId, key])
  @@index([applicationId, status, name])

  @@map("access_profiles")
}

model UserProfileAssignment {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  profileId String        @map("profile_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  profile   AccessProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@unique([userId, profileId])
  @@index([profileId])
  @@map("user_profile_assignments")
}

model UserApplicationAssignment {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([userId, applicationId])
  @@index([applicationId])
  @@map("user_application_assignments")
}

// La migración SQL agrega CHECK para la clave, la ruta interna, el orden y la coherencia
// entre estado y fecha de desactivación. Prisma no expresa estas invariantes de PostgreSQL.
model Application {
  id            String            @id @default(uuid()) @db.Uuid
  key           String            @unique
  name          String
  description   String?
  launchPath    String            @unique @map("launch_path")
  status        ApplicationStatus @default(ACTIVE)
  displayOrder  Int               @default(0) @map("display_order")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deactivatedAt DateTime?         @map("deactivated_at") @db.Timestamptz(6)
  accessProfiles AccessProfile[]
  userAssignments UserApplicationAssignment[]
  permissions ApplicationPermission[]

  @@index([status, displayOrder, name])
  @@map("applications")
}

model ApplicationPermission {
  id            String                      @id @default(uuid()) @db.Uuid
  applicationId String                      @map("application_id") @db.Uuid
  key           String
  name          String
  description   String?
  status        ApplicationPermissionStatus @default(ACTIVE)
  createdAt     DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deactivatedAt DateTime?                   @map("deactivated_at") @db.Timestamptz(6)
  application   Application                 @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  profiles      AccessProfilePermission[]

  @@unique([applicationId, key])
  @@index([applicationId, status, name])
  @@map("application_permissions")
}

model AccessProfilePermission {
  id           String                @id @default(uuid()) @db.Uuid
  profileId    String                @map("profile_id") @db.Uuid
  permissionId String                @map("permission_id") @db.Uuid
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  profile      AccessProfile         @relation(fields: [profileId], references: [id], onDelete: Restrict)
  permission   ApplicationPermission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([profileId, permissionId])
  @@index([permissionId])
  @@map("access_profile_permissions")
}

model OAuthLoginAttempt {
  id           String    @id @default(uuid()) @db.Uuid
  stateHash    String    @unique @map("state_hash")
  pkceVerifier String    @map("pkce_verifier")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("oauth_login_attempts")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// La migración SQL agrega CHECK para: coherencia de actor (incluido USER/SYSTEM/ANONYMOUS),
// expires_at > occurred_at, textos identificadores no vacíos, objetivo coherente y metadata
// JSONB de tipo objeto. Prisma no expresa estas invariantes de PostgreSQL de forma declarativa.
model AuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  actorUserId    String?        @map("actor_user_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  systemActorKey String?        @map("system_actor_key")
  appKey         String         @map("app_key")
  eventName      String         @map("event_name")
  outcome        AuditOutcome
  targetType     String?        @map("target_type")
  targetId       String?        @map("target_id")
  requestId      String         @map("request_id")
  metadata       Json
  occurredAt     DateTime       @map("occurred_at") @db.Timestamptz(6)
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(6)
  actorUser      User?          @relation("AuditEventActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([appKey, occurredAt])
  @@index([eventName, occurredAt])
  @@map("audit_events")
}

// La futura migración SQL agrega CHECK para expires_at > occurred_at, textos no vacíos,
// coherencia de objetivo, metadata JSONB objeto y pg_column_size(metadata) <= 4096. Prisma no
// puede declarar estas invariantes de PostgreSQL; el servicio limita la entrada a 3072 bytes
// UTF-8 como margen conservador, sin asumir equivalencia byte a byte con la representación JSONB.
model UsageEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique @map("event_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  appKey      String   @map("app_key")
  eventName   String   @map("event_name")
  visitId     String   @map("visit_id") @db.Uuid
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  requestId   String   @map("request_id")
  metadata    Json
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  actorUser   User     @relation("UsageEventActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([appKey, occurredAt])
  @@index([eventName, occurredAt])
  @@index([visitId, occurredAt])
  @@map("usage_events")
}

// La migración SQL agrega CHECK para la clave, la longitud del nombre y la coherencia entre
// estado y fecha de desactivación, igual que Application. Prisma no expresa estas invariantes.
model FiveSIndicator {
  id              String               @id @default(uuid()) @db.Uuid
  key             String               @unique
  name            String
  controlledSince DateTime             @map("controlled_since") @db.Date
  displayOrder    Int                  @default(0) @map("display_order")
  status          FiveSIndicatorStatus @default(ACTIVE)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deactivatedAt   DateTime?            @map("deactivated_at") @db.Timestamptz(6)
  entries         FiveSDailyEntry[]

  @@index([status, displayOrder, name])
  @@map("five_s_indicators")
}

// Un mismo día/persona/indicador tiene a lo sumo un valor: sin fila registrada, el indicador
// queda pendiente para esa persona ese día (igual que una celda vacía en la planilla original).
// Prisma no puede declarar en el schema que userId y recordedByUserId apuntan a la misma tabla
// User con roles distintos sin dos relaciones nombradas explícitas.
model FiveSDailyEntry {
  id               String          @id @default(uuid()) @db.Uuid
  entryDate        DateTime        @map("entry_date") @db.Date
  userId           String          @map("user_id") @db.Uuid
  indicatorId      String          @map("indicator_id") @db.Uuid
  value            FiveSEntryValue
  recordedByUserId String          @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User            @relation("FiveSDailyEntryUser", fields: [userId], references: [id], onDelete: Restrict)
  indicator        FiveSIndicator  @relation(fields: [indicatorId], references: [id], onDelete: Restrict)
  recordedByUser   User            @relation("FiveSDailyEntryRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@unique([entryDate, userId, indicatorId])
  @@index([entryDate])
  @@index([userId, entryDate])
  @@map("five_s_daily_entries")
}
