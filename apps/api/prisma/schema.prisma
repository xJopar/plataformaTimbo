generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum AccessProfileKey {
  PLATFORM_ADMIN

  @@map("access_profile_key")
}

enum AuditActorType {
  USER
  SYSTEM
  ANONYMOUS

  @@map("audit_actor_type")
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE

  @@map("audit_outcome")
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  displayName    String?       @map("display_name")
  corporateEmail String        @unique @map("corporate_email")
  googleSubject  String?       @unique @map("google_subject")
  zohoCrmUserId  String?       @unique @map("zoho_crm_user_id")
  status         UserStatus    @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deactivatedAt  DateTime?     @map("deactivated_at") @db.Timestamptz(6)
  sessions       UserSession[]
  profileAssignments UserProfileAssignment[]
  auditEvents    AuditEvent[]  @relation("AuditEventActorUser")
  usageEvents    UsageEvent[]  @relation("UsageEventActorUser")

  @@map("users")
}

model AccessProfile {
  id          String                  @id @default(uuid()) @db.Uuid
  key         AccessProfileKey        @unique
  assignments UserProfileAssignment[]

  @@map("access_profiles")
}

model UserProfileAssignment {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  profileId String        @map("profile_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  profile   AccessProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@unique([userId, profileId])
  @@index([profileId])
  @@map("user_profile_assignments")
}

model OAuthLoginAttempt {
  id           String    @id @default(uuid()) @db.Uuid
  stateHash    String    @unique @map("state_hash")
  pkceVerifier String    @map("pkce_verifier")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("oauth_login_attempts")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// La migración SQL agrega CHECK para: coherencia de actor (incluido USER/SYSTEM/ANONYMOUS),
// expires_at > occurred_at, textos identificadores no vacíos, objetivo coherente y metadata
// JSONB de tipo objeto. Prisma no expresa estas invariantes de PostgreSQL de forma declarativa.
model AuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  actorUserId    String?        @map("actor_user_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  systemActorKey String?        @map("system_actor_key")
  appKey         String         @map("app_key")
  eventName      String         @map("event_name")
  outcome        AuditOutcome
  targetType     String?        @map("target_type")
  targetId       String?        @map("target_id")
  requestId      String         @map("request_id")
  metadata       Json
  occurredAt     DateTime       @map("occurred_at") @db.Timestamptz(6)
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(6)
  actorUser      User?          @relation("AuditEventActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([appKey, occurredAt])
  @@index([eventName, occurredAt])
  @@map("audit_events")
}

// La futura migración SQL agrega CHECK para expires_at > occurred_at, textos no vacíos,
// coherencia de objetivo, metadata JSONB objeto y pg_column_size(metadata) <= 4096. Prisma no
// puede declarar estas invariantes de PostgreSQL; el servicio limita la entrada a 3072 bytes
// UTF-8 como margen conservador, sin asumir equivalencia byte a byte con la representación JSONB.
model UsageEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique @map("event_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  appKey      String   @map("app_key")
  eventName   String   @map("event_name")
  visitId     String   @map("visit_id") @db.Uuid
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  requestId   String   @map("request_id")
  metadata    Json
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  actorUser   User     @relation("UsageEventActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([appKey, occurredAt])
  @@index([eventName, occurredAt])
  @@index([visitId, occurredAt])
  @@map("usage_events")
}
