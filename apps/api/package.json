{
  "name": "@timbo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node --env-file-if-exists=../../.env dist/main.js\"",
    "prisma:validate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js validate --config prisma.config.ts",
    "prisma:generate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate --config prisma.config.ts",
    "prisma:migrate:dev": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev --config prisma.config.ts",
    "prisma:migrate:deploy": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate deploy --config prisma.config.ts",
    "preauthorize-user": "node scripts/run-preauthorize-user.cjs",
    "predev": "pnpm run prisma:generate",
    "prebuild": "pnpm run prisma:generate",
    "pretypecheck": "pnpm run prisma:generate",
    "pretest": "pnpm run prisma:generate",
    "pretest:users:integration": "pnpm run prisma:generate",
    "pretest:auth:persistence:integration": "pnpm run prisma:generate",
    "build": "tsc -p tsconfig.build.json",
    "export:openapi": "node -r ts-node/register src/export-openapi.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest",
    "test:users:integration": "node --env-file-if-exists=../../.env --experimental-vm-modules test/run-users-integration.cjs",
    "test:auth:persistence:integration": "node --env-file=../../.env --experimental-vm-modules test/run-auth-persistence-integration.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "google-auth-library": "11.0.2",
    "pg": "8.23.0",
    "prisma": "7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "tsc-watch": "^7.2.1"
  }
}
