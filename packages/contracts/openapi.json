{
  "openapi": "3.0.0",
  "paths": {
    "/api/auth/google": {
      "get": {
        "operationId": "startGoogleLogin",
        "parameters": [],
        "responses": {
          "302": {
            "description": "Redirección al proveedor Google."
          }
        },
        "summary": "Inicia el acceso con Google.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/google/callback": {
      "get": {
        "operationId": "completeGoogleLogin",
        "parameters": [],
        "responses": {
          "303": {
            "description": "Sesión creada y redirección al origen web configurado."
          }
        },
        "summary": "Completa el acceso con Google.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/session": {
      "get": {
        "operationId": "getAuthSession",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponseDto"
                }
              }
            }
          }
        },
        "summary": "Obtiene la sesión autenticada vigente.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Sesión revocada o cookie ya ausente."
          }
        },
        "summary": "Revoca la sesión actual.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/admin/users": {
      "get": {
        "operationId": "listAdministrativeUsers",
        "parameters": [
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Texto a buscar en el correo corporativo.",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AdministrativeUserResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Lista usuarios para Administración.",
        "tags": [
          "administration"
        ]
      },
      "post": {
        "operationId": "preauthorizeAdministrativeUser",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreauthorizeAdministrativeUserDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdministrativeUserResponseDto"
                }
              }
            }
          }
        },
        "summary": "Preautoriza un usuario.",
        "tags": [
          "administration"
        ]
      }
    },
    "/api/admin/users/{userId}": {
      "patch": {
        "operationId": "updateAdministrativeUser",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAdministrativeUserDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdministrativeUserResponseDto"
                }
              }
            }
          }
        },
        "summary": "Actualiza únicamente el nombre visible de un usuario.",
        "tags": [
          "administration"
        ]
      }
    },
    "/api/admin/users/{userId}/deactivate": {
      "post": {
        "operationId": "deactivateAdministrativeUser",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Usuario desactivado."
          }
        },
        "summary": "Desactiva un usuario.",
        "tags": [
          "administration"
        ]
      }
    },
    "/api/admin/users/{userId}/reactivate": {
      "post": {
        "operationId": "reactivateAdministrativeUser",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Usuario reactivado."
          }
        },
        "summary": "Reactiva un usuario.",
        "tags": [
          "administration"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "La API está disponible y responde correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Consulta el estado de disponibilidad de la API.",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Plataforma Timbo — API",
    "description": "Documentación de las operaciones expuestas por la API de Plataforma Timbo.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "AuthSessionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "d9e7d1f5-4c1e-4a77-9b63-4f37b755f1d6"
          },
          "corporateEmail": {
            "type": "string",
            "example": "persona@timbo.com"
          },
          "displayName": {
            "type": "string",
            "example": "Persona Timbo",
            "nullable": true
          }
        },
        "required": [
          "id",
          "corporateEmail",
          "displayName"
        ]
      },
      "AdministrativeUserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "d9e7d1f5-4c1e-4a77-9b63-4f37b755f1d6"
          },
          "corporateEmail": {
            "type": "string",
            "example": "persona@timbo.com"
          },
          "displayName": {
            "type": "string",
            "example": "Persona Timbo",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ],
            "example": "ACTIVE"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-08-21T12:00:00.000Z"
          },
          "deactivatedAt": {
            "type": "object",
            "example": "2026-08-21T12:00:00.000Z",
            "format": "date-time",
            "nullable": true
          },
          "isPlatformAdministrator": {
            "type": "boolean",
            "example": false,
            "description": "Indica si el usuario tiene la asignación PLATFORM_ADMIN protegida."
          }
        },
        "required": [
          "id",
          "corporateEmail",
          "displayName",
          "status",
          "createdAt",
          "deactivatedAt",
          "isPlatformAdministrator"
        ]
      },
      "PreauthorizeAdministrativeUserDto": {
        "type": "object",
        "properties": {
          "corporateEmail": {
            "type": "string",
            "example": "persona@timbo.com"
          },
          "displayName": {
            "type": "string",
            "example": "Persona Timbo"
          }
        },
        "required": [
          "corporateEmail"
        ]
      },
      "UpdateAdministrativeUserDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "Persona Timbo",
            "nullable": true
          }
        },
        "required": [
          "displayName"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok",
            "description": "Estado de disponibilidad de la API."
          },
          "timestamp": {
            "type": "string",
            "example": "2026-08-17T20:15:00.000Z",
            "description": "Marca de tiempo UTC, en formato ISO 8601, en la que se generó la respuesta."
          }
        },
        "required": [
          "status",
          "timestamp"
        ]
      }
    }
  }
}
