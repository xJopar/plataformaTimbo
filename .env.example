# Variables locales de App Shell Plataforma Timbo.
# Copiar este archivo como .env en la raíz. No versionar el archivo .env real.

# Puerto en el que escucha la API durante el desarrollo local.
# Railway inyecta PORT automáticamente: no se crea manualmente en el dashboard.
# Valor local por defecto si no se define: 3000.
PORT=3000

# Origen permitido por CORS para la API en desarrollo local.
# No es un secreto: identifica el origen del cliente web autorizado a llamar a la API.
# Valor local por defecto si no se define: http://localhost:5173
# En Railway (servicio api): https://${{web.RAILWAY_PUBLIC_DOMAIN}}
CORS_ORIGIN=http://localhost:5173

# Origen que usa la web para llamar a la API.
# No es un secreto: Vite lo incorpora en el cliente durante el desarrollo o la compilación.
# Valor local por defecto si no se define: http://localhost:3000 (recorrido directo Web :5173 -> API :3000).
# Objetivo posterior al push en Railway development (no aplicado por esta tanda): el propio
# origen público de web, para que el navegador llame a /api en el mismo origen y el gateway
# de web lo reenvíe a la API. Evita depender de cookies de terceros entre sitios *.up.railway.app.
VITE_API_BASE_URL=http://localhost:3000

# Origen interno de la API que usa el gateway del servicio Web para reenviar /api/*.
# Variable server-only: no lleva el prefijo VITE_, por lo que Vite nunca la incorpora al bundle.
# Sin valor por defecto: el gateway (apps/web/server) aborta el arranque si falta o es inválida.
# A diferencia de las variables anteriores, `pnpm start:web` NO carga el .env raíz (para no
# heredar el PORT de la API y chocar de puerto al verificar ambos servicios en simultáneo local);
# se define en el entorno del proceso que lanza el gateway.
# En Railway (servicio web), referencia de red privada del servicio api con el puerto que Railway
# le asignó: http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
# En local, para verificar el gateway contra la API local: http://localhost:3000
API_INTERNAL_ORIGIN=http://localhost:3000

# URL de PostgreSQL para la API y las migraciones locales. Es un secreto: usar sólo
# placeholders en este ejemplo y no versionar el archivo .env real.
# Debe apuntar exclusivamente a la base aislada de development durante el trabajo local.
# Las referencias privadas de Railway para development y producción se configuran sólo
# en el dashboard; consultar docs/RAILWAY_DEPLOYMENT.md.
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require

# Identificador público del cliente OAuth 2.0 de Google de tipo "Aplicación web".
# No es un secreto, pero pertenece a la configuración de la API: no se necesita
# una variable VITE_* ni debe configurarse en el servicio web.
GOOGLE_OAUTH_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com

# Secreto del cliente OAuth 2.0 de Google. Es un secreto de backend: guardar el
# valor real sólo en el .env local ignorado y en las variables privadas del
# servicio API de Railway. Nunca exponerlo al navegador, logs o repositorio.
GOOGLE_OAUTH_CLIENT_SECRET=<google-oauth-client-secret>

# Callback exacto registrado en Google Cloud para el entorno actual.
# Valor local: http://localhost:3000/api/auth/google/callback
# En Railway development:
# https://${{api.RAILWAY_PUBLIC_DOMAIN}}/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Nombre del entorno de ejecución incluido en el campo `environment` de los logs operativos
# estructurados de la API (ver docs/OBSERVABILITY_LOGGING.md). No es un secreto y no decide
# comportamiento de seguridad; si falta, la API asume "development".
NODE_ENV=development

# ── Zoho Analytics (módulo Lista de Precios) ──────────────────────────────
# Todas server-only: ninguna lleva prefijo VITE_, así que el navegador nunca las recibe.
# El módulo `apps/api/src/modules/lista-precios` resuelve y valida este bloque al construir
# el servicio (ver docs/MIGRATING_STANDALONE_APPS.md).

# Identificador de la organización de Zoho Analytics. No es un secreto.
ZOHO_ORG_ID=748410058

# Identificador del workspace de Zoho Analytics que contiene la vista de stock. No es un secreto.
ZOHO_WORKSPACE_ID=2400409000000791460

# Identificador de la vista (view) de Zoho Analytics a consultar. No es un secreto.
ZOHO_VIEW_ID=2400409000025208315

# Client ID del "Self Client" de Zoho (api-console.zoho.com). Es un secreto de backend:
# guardar el valor real sólo en el .env local ignorado y en las variables privadas del
# servicio API de Railway. Nunca exponerlo al navegador, logs o repositorio.
ZOHO_CLIENT_ID=<zoho-self-client-id>

# Client secret del "Self Client" de Zoho. Es un secreto de backend; mismas reglas que
# ZOHO_CLIENT_ID.
ZOHO_CLIENT_SECRET=<zoho-self-client-secret>

# Refresh token permanente del "Self Client" de Zoho (scope ZohoAnalytics.data.READ).
# Es un secreto de backend; mismas reglas que ZOHO_CLIENT_ID.
ZOHO_REFRESH_TOKEN=<zoho-refresh-token>

# ── WhatsApp "Consultar disponibilidad" (módulo Lista de Precios, frontend) ────────────────
# No son secretos: Vite las incorpora en el cliente. Si faltan, el módulo usa un número y
# mensaje por defecto embebidos (ver apps/web/src/applications/lista-precios/lista-precios-application.tsx).

# Número de WhatsApp (formato internacional, sin "+") al que se dirige el botón de consulta.
VITE_LISTA_PRECIOS_WA_NUMBER=595976511016

# Plantilla del mensaje prellenado. "{modelo}" se reemplaza por el modelo (y stock, si hay
# una unidad seleccionada) al abrir WhatsApp.
VITE_LISTA_PRECIOS_WA_MESSAGE_TEMPLATE=Hola, ¿está disponible el modelo: {modelo}?
