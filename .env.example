# Puerto en el que escucha la API (opcional).
# Valor por defecto si no se define: 3000.
PORT=3000

# Origen permitido por CORS para la API en desarrollo local.
# No es un secreto: identifica el origen del cliente web autorizado a llamar a la API.
# Valor por defecto documentado si no se define: http://localhost:5173
# (servidor de desarrollo de Vite que se incorporará en la Tanda 2).
CORS_ORIGIN=http://localhost:5173
