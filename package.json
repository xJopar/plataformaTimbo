{
  "name": "timbo-app-shell",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @timbo/api dev",
    "dev:web": "pnpm --filter @timbo/web dev",
    "start:api": "pnpm --filter @timbo/api start",
    "start:web": "pnpm --filter @timbo/web start",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm -r run test",
    "generate:contracts": "pnpm --filter @timbo/api export:openapi ../../packages/contracts/openapi.json && pnpm --filter @timbo/contracts generate",
    "check:contracts": "node scripts/check-contracts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "pnpm": "11.22.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
